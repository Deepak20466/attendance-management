# Database
DATABASE_URL=postgresql+psycopg2://vimj_user:changeme@localhost:5432/vimj_attendance

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Facility geofence
FACILITY_LAT=12.9716
FACILITY_LNG=77.5946
GEOFENCE_RADIUS_METERS=50

# Uploads
UPLOAD_DIR=uploads/selfies
MAX_SELFIE_SIZE_KB=500

# SMS / WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFICATIONS_ENABLED=false

# Rate limiting
LOGIN_RATE_LIMIT=5/15minutes

# App
ENV=development
